<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-machine MSI for the PyInstaller onedir build in `dist/GSim`.
  Built by `scripts/build_installer.ps1`, which passes -dVersion and -dSourceDir.

  Nothing here is generated by heat: `<Files Include="...">` harvests the whole
  PyInstaller output at build time, so adding a dependency (a new .pyd, another
  data file) needs no edit in this file at all. The three components below are
  the only hand-written ones, because a shortcut and a registry value have no
  source file to be harvested from.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="GSim"
           Manufacturer="Rapat"
           Version="$(Version)"
           UpgradeCode="0BD54DBC-465B-40CE-9A3F-D8FC5F68567E"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <!-- Upgrade in place: a newer build removes the older one first, so the
         install directory never accumulates files from two versions (a stale
         `assets/index-<oldhash>.js` would be harmless, a stale .pyd would not). -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of GSim is already installed. Uninstall it first to install [ProductVersion]." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs: the icon, and the version/publisher shown there,
         come from the Package attributes above plus this property. -->
    <Icon Id="GSimIcon" SourceFile="!(bindpath.src)\_internal\gsim\assets\gsim.ico" />
    <Property Id="ARPPRODUCTICON" Value="GSimIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="GSim" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="GSim" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="InstallRegistry" />
    </Feature>

    <!-- Folder-choosing wizard. WixUI_InstallDir needs to be told which
         directory property its Browse dialog edits. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="!(bindpath.installer)\License.rtf" />

  </Package>

  <Fragment>
    <!-- Every file PyInstaller produced, at the same relative layout: `GSim.exe`
         beside `_internal\`, which is the ONLY layout a onedir build runs in.
         Component GUIDs are generated deterministically by WiX from each file's
         destination path, so they stay stable across rebuilds and upgrades
         remove exactly what they installed. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.src)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!-- Shortcuts point at the .exe by path rather than by File element id: the
         harvested ids are generated and not meant to be referenced by hand.
         Each shortcut component needs a keypath that is not a file, hence the
         registry values: HKLM, matching this package's perMachine scope. -->
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="E16B607D-370C-41BA-B1FA-BEAE4009FB10">
      <Shortcut Id="StartMenuGSim"
                Name="GSim"
                Description="Generic Simulator: compose, send and watch IRS traffic"
                Target="[INSTALLFOLDER]GSim.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="GSimIcon" />
      <RegistryValue Root="HKLM" Key="Software\Rapat\GSim" Name="StartMenuShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="D39F11FE-18F0-4725-A5BC-905B2D26659A">
      <Shortcut Id="DesktopGSim"
                Name="GSim"
                Description="Generic Simulator: compose, send and watch IRS traffic"
                Target="[INSTALLFOLDER]GSim.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="GSimIcon" />
      <RegistryValue Root="HKLM" Key="Software\Rapat\GSim" Name="DesktopShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Where GSim landed, for anything that needs to find it without guessing
         at Program Files (a launcher script, a support request, a later
         installer). Written under the install directory's own key so uninstall
         removes it. -->
    <Component Id="InstallRegistry" Directory="INSTALLFOLDER" Guid="7C31B0E9-42D4-4A0B-9F5E-6C8A2B1D4E77">
      <RegistryValue Root="HKLM" Key="Software\Rapat\GSim" Name="InstallDir"
                     Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Rapat\GSim" Name="Version"
                     Type="string" Value="$(Version)" />
    </Component>
  </Fragment>
</Wix>
